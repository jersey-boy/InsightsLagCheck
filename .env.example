# NationBuilder Insights (Tableau) API credentials
# Copy this file to `.env` and fill in your own values.
# `.env` is gitignored; this template must only ever hold placeholders.

NB_INSIGHTS_SERVER=https://login.insights.nationbuilder.com
# Set to match the server's REST API version (currently 3.23).
NB_INSIGHTS_API_VERSION=3.23
NB_INSIGHTS_SITE_NAME=your-site-name
NB_INSIGHTS_SITE_URL=your-site-url

NB_INSIGHTS_TOKEN_NAME=your-personal-access-token-name
NB_INSIGHTS_TOKEN_SECRET=your-personal-access-token-secret

# --- NationBuilder V2 API (OAuth 2.0) ---------------------------------------
# The NationBuilder side of the comparison pulls every signup from the V2 API
# using an OAuth 2.0 refresh-token flow (see V2_OAUTH_SETUP.md). The client_id/
# secret come from a registered OAuth app; the refresh token is obtained once
# via the browser authorize handshake and is rotated/persisted on each run.
NATIONBUILDER_SLUG=your-nation-slug
NATIONBUILDER_CLIENT_ID=your-oauth-client-id
NATIONBUILDER_CLIENT_SECRET=your-oauth-client-secret
NATIONBUILDER_REDIRECT_URI=https://localhost:8080/callback
NATIONBUILDER_REFRESH_TOKEN=your-refresh-token
# Optional: a current access token (the client normally mints one from the
# refresh token, so this is usually not needed).
# NATIONBUILDER_ACCESS_TOKEN_V2=
# Parallel page-fetch concurrency for the full V2 pull (default 20).
# NB_LOOKUP_CONCURRENCY=20

# ===========================================================================
# The settings below are only needed for the AWS Lambda deployment of the
# comparison pipeline (lambda_pipeline.handler). Local runs ignore them unless
# set. See DEPLOY.md for the full step-by-step.
# ===========================================================================

# --- AWS Secrets Manager (Lambda credential source) ------------------------
# In Lambda the NATIONBUILDER_* (V2 OAuth) and NB_INSIGHTS_* (Tableau) creds
# live in ONE combined secret: a JSON object whose keys are those variable
# names. Point both secret-id vars at the same secret; each loader copies only
# the keys it recognizes, without overwriting anything already in the env.
# The function also WRITES the rotated V2 refresh token back to this secret
# after each run, so the role needs secretsmanager:PutSecretValue.
# Leave unset for local runs (which use the plain values above).
# NATIONBUILDER_SECRET_ID=nb/insightslag/prod
# NATIONBUILDER_SECRET_REGION=eu-west-2
# NB_INSIGHTS_SECRET_ID=nb/insightslag/prod
# NB_INSIGHTS_SECRET_REGION=eu-west-2

# --- Output location -------------------------------------------------------
# Directory for the generated CSV/XLSX files. Defaults to the current directory
# for local runs. In AWS Lambda set this to /tmp (the only writable path).
# OUTPUT_DIR=.

# --- Optional S3 upload ----------------------------------------------------
# When S3_BUCKET is set, every comparison report is uploaded to
# s3://<bucket>/<prefix>/<name>. Object names are date-stamped with the run date
# (e.g. comparison_mismatches_YYYYMMDD.csv) so a history builds up in the bucket;
# local file names stay undated. A presigned URL is also generated per object.
# Leave S3_BUCKET unset to keep output local only. This project uses its OWN
# bucket (separate from ZipStateFed). Credentials are NOT set here: locally
# boto3 uses your AWS profile/env, in Lambda the function's IAM role.
# S3_BUCKET=insightslagcheck-reports-<account-id>
# S3_PREFIX=insights-lag-reports/
# S3_REGION=eu-west-2
# Presigned URL lifetime in seconds (default 604800 = 7 days; that is S3's max).
# PRESIGN_EXPIRY_SECONDS=604800

# --- Optional email notification (Amazon SES) ------------------------------
# When SES_SENDER is set (a verified SES identity) and a recipient list is
# available, the comparison reports (comparison_mismatches.csv/.xlsx plus
# comparison.csv) are emailed as FILE ATTACHMENTS (dated names) after the run.
# The full comparison.xlsx is uploaded to S3 but not emailed. An attachment is
# skipped (noted in the body) if it would exceed the SES ~10 MB message limit.
# The recipient list is one address per line ("#" comments); source it from S3
# (RECIPIENTS_S3_URI) or a local file (RECIPIENTS_FILE, default recipients.txt).
# SES_SENDER=insights-reports@your-verified-domain
# SES_REGION=eu-west-2
# RECIPIENTS_S3_URI=s3://insightslagcheck-reports-<account-id>/config/recipients.txt
# RECIPIENTS_FILE=recipients.txt
# Free-text message in the email body (default explains what the report shows).
# EMAIL_MESSAGE=...
