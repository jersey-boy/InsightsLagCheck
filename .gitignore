.DS_Store
._*

# Data / output
*.csv
*.xlsx
!data_sources.example.csv

# Run artifacts — regenerated each run (may contain member counts / names).
*.status.txt

# Run logs from the pipeline pulls (regenerated each run).
*.log

# Lambda build artifacts (regenerated by build_lambda_zip.py)
build/
lambda_deploy.zip

# Serverless Framework / Node
node_modules/
.serverless/

# Lambda invoke output — contains presigned URLs with temporary tokens.
aws/response.json

# IDE
.vscode/
.idea/

# Local working notes / chat transcripts (not part of the project source).
Chats/

# Learning material — local-only tutorials written from this project
# (Markdown source + any Word/other exports of them).
tutorial/
word/

# Recipient list contains real email addresses (PII); the live copy lives in S3.
recipients.txt

# NOTE: the aws/ IAM + env templates (trust/permissions/scheduler/lambda-env)
# ARE committed — they use ACCOUNT_ID / YOUR_BUCKET placeholders, no secrets.
# Only aws/response.json (Lambda invoke output with presigned URLs) is ignored,
# via its own rule above.
