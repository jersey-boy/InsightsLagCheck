# Keep the build context small and never bake secrets or data into the image.

# Secrets / local config
.env
.env.*
!.env.example

# Virtual environments
.venv/
venv/
env/

# Reference workbook (fetched from S3 at runtime, not bundled)
ZIP_Locale_Detail.xlsx

# Generated output / run artifacts (contain member PII)
*.csv
*.xlsx
*.log
*.status.txt
recipients.txt

# Legacy ZipStateFed AWS config (not used by this image)
aws/

# Version control & IDE
.git/
.gitignore
.idea/
.vscode/

# Docs and specs (not needed at runtime)
*.md
.kiro/

# Local working notes / chat transcripts
Chat*.docx
Chat*.md
Dennis.md

# Python caches
__pycache__/
*.py[cod]
